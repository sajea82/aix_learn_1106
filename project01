import time
from selenium import webdriver
from selenium.webdriver.common.by import By
import pandas as pd

options = webdriver.ChromeOptions()
driver = webdriver.Chrome(options=options)

movie_data_list = []

# 수집하고 싶은 4가지 장르 지정
target_genre_names = ["액션", "드라마", "스릴러", "코믹"]

try:
    target_url = "https://pedia.watcha.com/ko-KR" 
    driver.get(target_url)
    time.sleep(3)

    genre_items = driver.find_elements(By.CSS_SELECTOR, 'section[aria-label="추천 장르"] li.Du2NU')

    for item in genre_items:
        genre_name = item.text.strip()
        
        if genre_name in target_genre_names:
            print(nf"\n🎯 [{genre_name}] 장르 탐색 시작")
            genre_link = item.find_element(By.TAG_NAME, "a").get_attribute("href")
            
            driver.get(genre_link)
            time.sleep(3)
            
            # 해당 장르의 영화 카드 목록 가져오기 (※ 실제 사이트 클래스명에 맞게 확인 필요)
            movie_cards = driver.find_elements(By.CSS_SELECTOR, 'div.movie-card-class') 
            
            # 💡 각 장르별로 딱 3개씩만 추출
            target_movies = movie_cards[:3]
            
            for movie in target_movies:
                try:
                    # 영화 상세 페이지로 이동하거나 카드의 정보를 가져옴
                    # (만약 상세 페이지로 들어가야 한다면 링크 클릭 후 크롤링)
                    
                    title = movie.find_element(By.CSS_SELECTOR, ".yGvnZ").text
                    poster_src = movie.find_element(By.CSS_SELECTOR, "img").get_attribute("src")
                    
                    # 💡 추가된 4가지 항목 수집 영역 (실제 사이트 선택자로 변경 필요)
                    summary = movie.find_element(By.CSS_SELECTOR, ".summary-class").text
                    director = movie.find_element(By.CSS_SELECTOR, ".director-class").text
                    
                    # 배우는 여러 명일 수 있으므로 상위 3명만 가져와서 텍스트로 합치기
                    actor_elements = movie.find_elements(By.CSS_SELECTOR, ".actor-class")
                    actors = ", ".join([actor.text for actor in actor_elements[:3]])
                    
                    release_date = movie.find_element(By.CSS_SELECTOR, ".date-class").text
                    
                    # 7가지 정보 모두 담기
                    movie_info = {
                        "포스터": poster_src,
                        "제목": title,
                        "줄거리": summary,
                        "장르": genre_name,
                        "감독": director,
                        "배우": actors,
                        "개봉일": release_date
                    }
                    
                    movie_data_list.append(movie_info)
                    print(f"  - [수집 완료] {title} ({genre_name})")
                    
                except Exception as e:
                    print(f"  - 개별 영화 데이터 추출 실패: {e}")
            
            # 메인 페이지로 복귀 후 장르 목록 재로딩
            driver.get(target_url)
            time.sleep(3)
            genre_items = driver.find_elements(By.CSS_SELECTOR, 'section[aria-label="추천 장르"] li.Du2NU')

except Exception as e:
    print("❌ 크롤링 에러 발생:", e)

finally:
    driver.quit()

# 최종 데이터프레임 확인 및 CSV 저장
df = pd.DataFrame(movie_data_list)
print("\n--- 최종 수집 결과 ---")
print(df)
df.to_csv("watcha_movies.csv", index=False, encoding="utf-8-sig")